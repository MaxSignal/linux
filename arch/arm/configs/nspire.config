# TI-Nspire (Clickpad / Touchpad / CX) support on top of multi_v4t_defconfig:
#   make multi_v4t_defconfig nspire.config
CONFIG_ARCH_NSPIRE=y
# Display: PL111 LCD controller with the CX/classic panels, and the
# backlight (CX) / contrast (classic) control
CONFIG_DRM=y
CONFIG_DRM_PL111=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_NSPIRE=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_NSPIRE=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
# Keypad, ON key and touchpad
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_NSPIRE=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_NSPIRE_ONKEY=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_SYNAPTICS_I2C=y
# I2C: DesignWare controller on the CX, bit-banged GPIO on the Touchpad
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_GPIO=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ZEVIO=y
# Serial: 8250 on the classic models, PL011 on the CX
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# USB OTG (ChipIdea) with GPIO-controlled VBUS
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_EHCI_HCD=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# RTC, ADC, watchdog, SRAM, boot1 ROM
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_NSPIRE=y
CONFIG_IIO=y
CONFIG_NSPIRE_ADC=y
CONFIG_POWER_SUPPLY=y
CONFIG_GENERIC_ADC_BATTERY=y
CONFIG_WATCHDOG=y
CONFIG_ARM_SP805_WATCHDOG=y
CONFIG_SRAM=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SYSFS=y
CONFIG_NVMEM_NSPIRE_BOOTROM=y
# NAND flash (TI-Nspire OS partitions, read-only unless the DT says otherwise)
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_NSPIRE=y
# Block device on an image file in the TI-Nspire OS filesystem
CONFIG_MTD_NSPIRE_TIFS=y
# SHA-256 and DES engines
CONFIG_CRYPTO=y
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_NSPIRE=y
# The classic models have 32 MB of RAM: 2 MB of CMA is plenty for the
# framebuffer, where multi_v4t_defconfig keeps 16 MB
CONFIG_CMA_SIZE_MBYTES=2
# Suspend to idle, woken up by the ON key or an RTC alarm
CONFIG_SUSPEND=y
# CPU frequency scaling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_ARM_NSPIRE_CPUFREQ=y
