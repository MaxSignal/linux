#include "nspire.dtsi"

&lcd {
	port {
		clcd_pads: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&fast_timer {
	/* compatible = "lsi,zevio-timer"; */
	reg = <0x90010000 0x1000>, <0x900a0010 0x8>;
};

&uart {
	compatible = "ns16550";
	reg-shift = <2>;
	reg-io-width = <4>;
	clocks = <&apb_pclk>;
	no-loopback-test;
};

&timer0 {
	/* compatible = "lsi,zevio-timer"; */
	reg = <0x900c0000 0x1000>, <0x900a0018 0x8>;
};

&timer1 {
	compatible = "lsi,zevio-timer";
	reg = <0x900d0000 0x1000>, <0x900a0020 0x8>;
};

&keypad {
	active-low;

};

&contrast {
	compatible = "ti,nspire-classic-contrast";
};

&base_clk {
	compatible = "lsi,nspire-classic-clock";
};

&ahb_clk {
	compatible = "lsi,nspire-classic-ahb-divider";
};


&vbus_reg {
	gpio = <&gpio 5 0>;
};

/ {
	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x2000000>; /* 32 MB */
	};

	ahb {
		#address-cells = <1>;
		#size-cells = <1>;

		intc: interrupt-controller@dc000000 {
			compatible = "lsi,zevio-intc";
			interrupt-controller;
			reg = <0xdc000000 0x1000>;
			#interrupt-cells = <1>;
		};

		/* Partitions as laid out by the TI-Nspire OS */
		nand-controller@b8000000 {
			compatible = "ti,nspire-classic-nand";
			reg = <0xb8000000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;

			nand@0 {
				reg = <0>;

				partitions {
					compatible = "fixed-partitions";
					#address-cells = <1>;
					#size-cells = <1>;

					partition@0 {
						label = "manuf";
						reg = <0x0 0x4000>;
						read-only;
					};

					partition@4000 {
						label = "boot2";
						reg = <0x4000 0x14c000>;
						read-only;
					};

					partition@150000 {
						label = "bootdata";
						reg = <0x150000 0x10000>;
						read-only;
					};

					partition@160000 {
						label = "diags";
						reg = <0x160000 0xa0000>;
						read-only;
					};

					partition@200000 {
						label = "filesystem";
						reg = <0x200000 0x1e00000>;
						read-only;
					};
				};
			};
		};
	};

	panel {
		compatible = "ti,nspire-classic-lcd-panel";
		port {
			panel_in: endpoint {
				remote-endpoint = <&clcd_pads>;
			};
		};
	};
	chosen {
		bootargs = "debug earlyprintk console=tty0 console=ttyS0,115200n8 root=/dev/ram0";
	};
};
